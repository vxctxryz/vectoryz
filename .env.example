# p42m environment — copy to .env, set real values per box.
# NEVER commit .env. Only this .example.

# ── Environment identity ────────────────────────────────────
# DEVELOPMENT (Chromebook / Crostini) or PRODUCTION (Oracle cloud)
P42M_ENV=DEVELOPMENT

# ── Filesystem ──────────────────────────────────────────────
# Auto-detected from p42m_env.py location when unset.
# On Oracle: set to /opt/p42m or wherever the code lives.
# P42M_ROOT=/path/to/repo/root

# Where daemons write their logs.
# Default: $P42M_ROOT/logs (dev) or /tmp/p42m/logs (prod, tmpfs-safe).
# P42M_LOGS=

# ── Network / safebridge ────────────────────────────────────
# Bridge bind address. Stays 0.0.0.0 in both modes.
# P42M_BRIDGE_HOST=0.0.0.0
# P42M_BRIDGE_PORT=4243

# ── Secrets ─────────────────────────────────────────────────
# NEVER set in .env if that file could be synced (iCloud, etc).
# On Oracle: set via the shell at deploy time or via secret-manager.
# Required in PRODUCTION for bridge token auth.
P42M_SECRET=

# Polygon API key — canonical pipeline needs this.
# Runtime convention is POLYGON_API_KEY (polygon_feed.py, tick_driver,
# ops/calibration/polygon_backfill.py). p42m-run.sh and
# ops/run-with-secrets.sh source it via
#   secret-tool lookup service polygon-api user bsr
POLYGON_API_KEY=

# ── Cloud identity ──────────────────────────────────────────
# Human-readable region / hostname for the existence pulse.
# P42M_RZ_LOCATION=ORACLE-FRA

# Webhook the core POSTs its startup heartbeat to.
# When unset (dev default), send_existence_pulse() is a no-op.
# P42M_EXISTENCE_PULSE_URL=https://observer.example/pulse

# ── IBKR ────────────────────────────────────────────────────
# Gateway coords used by real_broker.
# IBKR_HOST=127.0.0.1
# IBKR_PORT=4001
# IBKR_CLIENT_ID=42
