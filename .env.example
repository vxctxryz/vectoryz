# ai-chat-wrapper environment — copy to .env, edit, source before run.
# NEVER commit .env. Only this .example.

# ── LLM engine endpoint ───────────────────────────────────────────
# OpenAI-compatible chat-completions endpoint (Ollama default shown).
OLLAMA_URL=http://localhost:11434

# Model identifier the engine will route to.
# Replace with whatever you have pulled / served.
DEFAULT_MODEL=your-model:latest

# ── Storage ───────────────────────────────────────────────────────
# SQLite file for session + chat storage.
STATE_DB=./state.db

# ── HTTP bind ─────────────────────────────────────────────────────
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8042

# ── Behaviour switches (optional) ─────────────────────────────────
# Multi-witness verification — enable for drift-detection
WRAPPER_V2_TRIBUNAL=1

# Per-claim verdict tagging in SSE output
WRAPPER_V2_FACTAMPEL=1

# Retry threshold — fraction of quasinonfact claims that triggers retry
WRAPPER_V2_RETRY_THRESHOLD=0.25
