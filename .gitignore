# .gitignore — Python + project conventions

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# IDE / editor cruft
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Local config / secrets — NEVER commit
.env
.env.local
.env.*.local
*.key
*.key.pub
*.pem
*.crt
*.crt.key
*.enc
secrets/
credentials/

# Local state / runtime files
state.db
state.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# ML models (download via README instructions)
*.ftz
*.bin
*.gguf
*/models/*.ftz

# Logs
*.log
logs/

# Coverage / test artifacts
.coverage
.coverage.*
.cache
.pytest_cache/
.tox/
.mypy_cache/
.ruff_cache/
htmlcov/
coverage.xml
*.cover

# OS-specific
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# Operator-private (downstream-fork can adapt as needed)
operator_memory/
private/
local_notes/
wrapper_v2/canonical_evals/*.Modelfile
