yoursite.example {
    encode gzip
    handle_path /api/* {
        reverse_proxy localhost:8042
    }
    root * /var/www/yoursite
    file_server
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer-when-downgrade"
    }
}
