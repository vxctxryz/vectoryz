[Unit]
Description=vectoryz HTTP server
After=network.target ollama.service
Requires=ollama.service

[Service]
Type=simple
User=vectoryz
Group=vectoryz
WorkingDirectory=/opt/vectoryz
ExecStart=/opt/vectoryz/.venv/bin/python -m vectoryz.server.wrapper_cc
Restart=on-failure
RestartSec=5
Environment="OLLAMA_URL=http://localhost:11434"
Environment="DEFAULT_MODEL=your-model:latest"
Environment="STATE_DB=/var/lib/vectoryz/state.db"
Environment="LISTEN_HOST=127.0.0.1"
Environment="LISTEN_PORT=8042"
Environment="WRAPPER_V2_TRIBUNAL=1"

[Install]
WantedBy=multi-user.target
