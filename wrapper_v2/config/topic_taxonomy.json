      "ford_overlay": "ford_natural_sciences",
      "default_persona": ["scientist", "mathematician"],
      "default_method": "empirical",
      "labels": {
        "EN": "Natural sciences, mathematics and statistics",
        "DE": "Naturwissenschaften, Mathematik und Statistik",
        "FR": "Sciences naturelles, mathématiques et statistiques",
        "ES": "Ciencias naturales, matemáticas y estadística",
