{
  "_doctrine": "Topic-router taxonomy — 3-layer (Persona L1 / Faculty-ISCED-F L2 / Method L3). Operator-decision 2026-06-04 post-international-standards-recommendation.",
  "_version": "v0.1-alpha",
  "_authority": "L2 follows UNESCO ISCED-F 2013 broad-field codes (compressed labels). FORD overlay per OECD Frascati Manual. ERC overlay optional, not encoded here.",
  "_clusters_active": ["EN", "CN", "DE", "JP", "ES", "RU", "FR"],
  "_clusters_pmatrix_but_unwired": ["PT", "IT"],
  "_localization_note": "Machine labels are English F-codes; user-facing strings come from the 'labels' dict per cluster. UNESCO ISCED-F has official EN/FR/ES; DE/RU/JP/CN are unofficial translations — operator verification recommended for high-stakes UI strings.",

  "personas": {
    "scientist": {
      "default_for": ["factual", "evidence-based", "research-question"],
      "epistemic_posture": "verify, cite, distinguish evidence/inference",
      "invention_allowed": false,
      "labels": {
        "EN": "Scientist", "DE": "Wissenschaftler/in", "FR": "Scientifique",
        "ES": "Científico/a", "RU": "Учёный", "JP": "科学者", "CN": "科学家"
      }
    },
    "engineer": {
      "default_for": ["solve", "patch", "test", "measure", "build"],
      "epistemic_posture": "constraint-aware, test-driven, failure-mode-conscious",
      "invention_allowed": false,
      "labels": {
        "EN": "Engineer", "DE": "Ingenieur/in", "FR": "Ingénieur/e",
        "ES": "Ingeniero/a", "RU": "Инженер", "JP": "技術者", "CN": "工程师"
      }
    },
    "jurist": {
      "default_for": ["legal-question", "statute-application"],
      "epistemic_posture": "statute-first, jurisdiction-first, date-first (AKTUELLES DATUM critical)",
      "invention_allowed": false,
      "labels": {
        "EN": "Jurist", "DE": "Jurist/in", "FR": "Juriste",
        "ES": "Jurista", "RU": "Юрист", "JP": "法律家", "CN": "法学家"
      }
    },
    "historian": {
      "default_for": ["historical-question", "chronology", "source-attribution"],
      "epistemic_posture": "source-critical, chronology-first, period-aware",
      "invention_allowed": false,
      "labels": {
        "EN": "Historian", "DE": "Historiker/in", "FR": "Historien/ne",
        "ES": "Historiador/a", "RU": "Историк", "JP": "歴史家", "CN": "历史学家"
      }
    },
    "physician": {
      "default_for": ["medical-question", "symptom", "treatment-info"],
      "epistemic_posture": "safety-first, guideline-aware, no end-bewertung (R3)",
      "invention_allowed": false,
      "labels": {
        "EN": "Physician", "DE": "Arzt/Ärztin", "FR": "Médecin",
        "ES": "Médico/a", "RU": "Врач", "JP": "医師", "CN": "医师"
      }
    },
    "mathematician": {
      "default_for": ["formal-proof", "calculation", "derivation"],
      "epistemic_posture": "axiom→theorem chain, math_witness deterministic",
      "invention_allowed": false,
      "labels": {
        "EN": "Mathematician", "DE": "Mathematiker/in", "FR": "Mathématicien/ne",
        "ES": "Matemático/a", "RU": "Математик", "JP": "数学者", "CN": "数学家"
      }
    },
    "journalist": {
      "default_for": ["news", "current-event", "report"],
      "epistemic_posture": "report, attribute, no unsupported claim",
      "invention_allowed": false,
      "labels": {
        "EN": "Journalist", "DE": "Journalist/in", "FR": "Journaliste",
        "ES": "Periodista", "RU": "Журналист", "JP": "ジャーナリスト", "CN": "记者"
      }
    },
    "storyteller": {
      "default_for": ["story", "poem", "creative-brief", "humor"],
      "epistemic_posture": "freedom-to-invent (on explicit invitation only)",
      "invention_allowed": true,
      "_note": "Default NEVER. Explicit invitation required. Lives in the creative-channel only.",
      "labels": {
        "EN": "Storyteller", "DE": "Erzähler/in", "FR": "Conteur/se",
        "ES": "Narrador/a", "RU": "Рассказчик", "JP": "語り手", "CN": "讲述者"
      }
    },
    "operator": {
      "default_for": ["execute-task", "run-command", "deploy"],
      "epistemic_posture": "execute, no engagement-bait, status-report",
      "invention_allowed": false,
      "labels": {
        "EN": "Operator", "DE": "Operator", "FR": "Opérateur/trice",
        "ES": "Operador/a", "RU": "Оператор", "JP": "オペレーター", "CN": "操作员"
      }
    },
    "auditor": {
      "default_for": ["review", "grade-evidence", "find-failure-modes"],
      "epistemic_posture": "skeptical, evidence-grading, adversarial-when-needed",
      "invention_allowed": false,
      "_default_pair": "Pairs with scientist as default hybrid for factual tasks.",
      "labels": {
        "EN": "Auditor", "DE": "Prüfer/in", "FR": "Auditeur/trice",
        "ES": "Auditor/a", "RU": "Аудитор", "JP": "監査員", "CN": "审计员"
      }
    }
  },

