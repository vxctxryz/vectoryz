  "methods": {
    "empirical": {
      "goal": "observe, measure, compare",
      "needs": ["data", "sampling", "uncertainty quantification"],
      "tuyuca_mode": "on",
      "verification_config": {
        "tribunal_weight_data": "high",
        "math_witness": "for any statistics",
        "search_depth": "HIGH",
        "confab_allowed": false
      }
    },
    "formal": {
      "goal": "prove, derive, calculate",
      "needs": ["definitions", "axioms", "stepwise derivation"],
      "tuyuca_mode": "on",
      "verification_config": {
        "math_witness": "deterministic_required",
        "tribunal_weight_logic": "high",
        "search_depth": "HIGH",
        "confab_allowed": false
      }
    },
    "interpretive": {
      "goal": "understand meaning / context",
      "needs": ["source reading", "hermeneutics", "chronology"],
      "tuyuca_mode": "on",
      "verification_config": {
        "tribunal_weight_source": "high",
        "url_witness": "fetched-only",
        "search_depth": "MODERATE",
        "confab_allowed": false
      }
    },
    "legal_normative": {
      "goal": "apply rule to facts",
      "needs": ["jurisdiction", "current law (AKTUELLES DATUM)", "hierarchy of norms"],
      "tuyuca_mode": "strict",
      "verification_config": {
        "aktuelles_datum_required": true,
        "r2_aktenzeichen_suffix_required": true,
        "search_depth": "BRUTAL",
        "confab_allowed": false
      }
    },
    "engineering_design": {
      "goal": "build artifact",
      "needs": ["constraints", "tests", "failure modes"],
      "tuyuca_mode": "on",
      "verification_config": {
        "tribunal_weight_logic": "high",
        "search_depth": "HIGH",
        "confab_allowed": false,
        "post_check": "tests_described"
      }
    },
    "clinical_diagnostic": {
      "goal": "risk / symptom assessment",
      "needs": ["safety triage", "professional disclaimer", "current guidelines"],
      "tuyuca_mode": "strict",
      "verification_config": {
        "r3_no_end_bewertung": true,
        "aktuelles_datum_required": true,
        "search_depth": "BRUTAL",
        "confab_allowed": false,
        "post_check": "doctor_referral_suggested"
      }
    },
    "operational": {
      "goal": "execute task",
      "needs": ["filesystem/tool state", "commands", "status reporting"],
      "tuyuca_mode": "off",
      "verification_config": {
        "vorwerk_check": "required",
        "search_depth": "LIGHTER",
        "confab_allowed": false
      }
    },
    "creative": {
      "goal": "generate variants",
      "needs": ["style constraints", "audience", "freedom-to-invent flag"],
      "tuyuca_mode": "off",
      "verification_config": {
        "freedom_to_invent": true,
        "channel": "6_7_creative",
        "connotation_check": "required",
        "factual_claims_inside_creative": "still_gated",
        "search_depth": "LIGHTER"
      }
    }
  },

  "ford_overlay": {
    "ford_natural_sciences": ["F05", "F06"],
    "ford_engineering_technology": ["F06", "F07"],
    "ford_medical_health": ["F09"],
    "ford_agricultural_veterinary": ["F08"],
    "ford_social_sciences": ["F01", "F03", "F04"],
    "ford_humanities": ["F02"]
  },

  "defaults": {
    "factual_task": {
      "persona": ["scientist", "auditor"],
      "invention_allowed": false,
      "source_claim_requires_source": true,
      "time_required": true,
      "confab_allowed": false
    },
    "creative_task": {
      "persona": ["storyteller"],
      "invention_allowed": true,
      "factual_claims_inside": "still_gated",
      "confab_allowed": true,
      "channel": "6_7_creative",
      "connotation_check": "required"
    },
    "unknown_task": {
      "persona": ["scientist", "auditor"],
      "_rule": "When ambiguous, default to factual mode (NEVER to storyteller)."
    }
  }
}
